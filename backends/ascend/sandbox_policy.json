{
  "schema_version": 1,
  "backend": "ascend",
  "production": {
    "dedicated_uid_required": true,
    "direct_supervisor_required": true,
    "private_mount_namespace_required": true,
    "same_uid_fallback_allowed": false,
    "compiler_inputs_read_only": true,
    "manager_authority_visible": false
  },
  "provider_request": {
    "cache_role": "provider_scratch",
    "request_private_cache": true,
    "request_private_tmpdir": true,
    "production_cache_visible": false
  },
  "runtime_attestation": {
    "cache_role": "production",
    "start_gate_required": true,
    "workspace_must_be_zero": true
  }
}
